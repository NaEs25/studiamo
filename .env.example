# ============================================================
# Studiamo, Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Telegram Bot (optional, self-hosted BYO bot) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Telegram Managed Bot (cloud mode only) ---
# A single shared bot cloud users connect to from Settings without creating
# their own. Leave unset to disable the "Connect Telegram" flow.
TELEGRAM_MANAGED_BOT_TOKEN=your_managed_bot_token_here
TELEGRAM_MANAGED_BOT_USERNAME=YourStudiamoBot

# --- YouTube Data API (optional) ---
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- App Base URL ---
BASE_URL=https://yourdomain.com

# --- Waitlist Email (STRATO SMTP or any SMTP provider) ---
# Used by the pre-launch landing-page email waitlist only.
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_USER=hello@yourdomain.com
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM=Studiamo <hello@yourdomain.com>

# --- Resend (account waitlist + promotion emails) ---
RESEND_API_KEY=your_resend_api_key_here

# --- Lemon Squeezy (cloud mode only) ---
# Merchant of Record for Studiamo Cloud subscriptions. Required when APP_MODE=cloud;
# ignored self-hosted, where users bring their own Gemini key and pay nothing.
# API key:        Lemon Squeezy -> Settings -> API
# Webhook secret: Lemon Squeezy -> Settings -> Webhooks (the signing secret you choose)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here
# Hosted checkout URL for your product variant (Product -> Share -> Checkout Link).
LEMONSQUEEZY_BUY_URL=https://yourstore.lemonsqueezy.com/checkout/buy/your-variant-id
# Discount code granting a promotional price, if you use one. Only ever applied to
# checkouts opened from the paywall's second-chance offer.
LEMONSQUEEZY_BETA_DISCOUNT_CODE=your_discount_code_here

# Beta-only: log completed import durations to the import_timings table so the
# import progress bar can be calibrated (static/js/core.js). No usernames or
# titles are recorded. Set to false, or remove the code entirely, after beta.
ENABLE_IMPORT_TIMING_LOG=true
