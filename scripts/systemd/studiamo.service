[Unit]
Description=Studiamo Spaced Repetition Learning System
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=naes
WorkingDirectory=/home/naes/studiamo
ExecStartPre=/home/naes/studiamo/scripts/build_css.sh
ExecStart=/home/naes/studiamo/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 5004
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardware protection limits for co-hosted services
CPUQuota=150%
MemoryMax=1.5G
MemoryHigh=1.2G
Nice=5

[Install]
WantedBy=multi-user.target
