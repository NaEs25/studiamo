# Studiamo Self-Hosted Environment Template
APP_MODE=selfhosted

# Database Connection. Only used if you run the app outside Docker Compose, e.g. directly
# via uvicorn against a Postgres you started separately. docker-compose.yml sets DATABASE_URL
# itself (pointing at the postgres service by its internal Docker name) and ignores this
# value entirely, so `docker compose up -d` users can leave this line alone.
DATABASE_URL=postgresql://studiamo:studiamopassword@localhost:5432/studiamo

# Signs session cookies. Left unset, the app generates a random one on every process start,
# which logs every signed-in user out on every container restart. Set a real value before
# leaving this running unattended: `openssl rand -hex 32`.
YB_SECRET_KEY=

# Maximum registration limit for local selfhosted instance
MAX_SELFHOSTED_USERS=10

# Optional: Storage Quota & Upload Limits
# Self-hosted mode is uncapped by default (0). Set these if you want to cap disk usage or upload sizes:
# MAX_USER_STORAGE_GB=2       # Total storage limit per user in GB (or use MAX_USER_STORAGE_MB)
# MAX_FILE_UPLOAD_MB=50      # Maximum single-file upload size in MB

# Optional: System-wide default Gemini API Key (Users can also provide their own BYOK key in settings)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional but needed for goal/daily recommendations: a YouTube Data API v3 key, separate
# from the Gemini key above. Without it, recommendations silently return empty rather than
# erroring. Get one from https://console.cloud.google.com/apis/library/youtube.googleapis.com
# (enable "YouTube Data API v3" on a project, then create an API key). Users can also provide
# their own BYOK key in settings instead of setting this system-wide.
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Application Port and Host settings
PORT=5004
YB_ALLOWED_ORIGINS=http://localhost:5004
